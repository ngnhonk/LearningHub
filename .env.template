# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="http://localhost:5173" # Allowed CORS origin, adjust as necessary

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"  # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="20" # Max number of requests per window per IP

# Database Configuration4
DB_HOST="localhost"       # Database host
DB_PORT="3306"            # Database
DB_PASSWORD='your_password'
DB_NAME='your_db_name'
DB_USER="root"

# JWT settings
JWT_SECRET="secret"                  # Base JWT secret
JWT_TEMP_SECRET="secret"             # JWT secret for create temp token
JWT_ACCESS_TOKEN_SECRET="secret"     # JWT secret for access token
JWT_REFRESH_TOKEN_SECRET="secret"    # JWT secret for refresh token

JWT_ACCESS_TOKEN_TIME=0.5 #hour             # exists time for access token
JWT_REFRESH_TOKEN_TIME=48 #hour             # exists time for refresh token

# Hash settings
TOKEN_HASH_SECRET="secret"
SALT_ROUNDS=10

EMAIL_USER='example@email.com'
EMAIL_PASS='xxxx xxxx xxxx xxxx'

# AI Provider Configuration
AI_DEFAULT_PROVIDER=openrouter           # openrouter | ollama | nvidia
AI_DEFAULT_MODEL=google/gemini-2.5-flash # Default LLM model

# OpenRouter (get key at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-your-key-here

# Ollama (local inference - optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# NVIDIA NIM (optional - get key at https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                          # Empty for local Docker
QDRANT_COLLECTION=learning_documents

# Embedding
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536